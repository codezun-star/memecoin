# ---------------------------------------------------------------------------
# Supabase — Project Settings > API en el panel de Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# ---------------------------------------------------------------------------
# URL pública del sitio. Se usa para los redirect de OAuth y para las URLs
# canónicas / Open Graph.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://memecoin.codezun.com

# ---------------------------------------------------------------------------
# CoinGecko — opcional. Sin key funciona con el tier público (~30 req/min).
# Con una Demo API key gratuita el límite sube bastante.
# https://www.coingecko.com/en/api/pricing
# ---------------------------------------------------------------------------
# COINGECKO_API_KEY=CG-xxxxxxxxxxxx
